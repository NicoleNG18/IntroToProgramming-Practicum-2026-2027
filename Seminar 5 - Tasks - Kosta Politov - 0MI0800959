double averageOfArrey(int arr[], size_t size) {
    int sum = 0;

    for (int i = 0; i < size; i++) {
        sum += arr[i];
    }
    return sum / size;
}

int aboveAverage(int arr[], size_t size, double average) {
    int count = 0;

    for (int i = 0; i < size; i++) {
        if (arr[i] > average) {
            count++;
        }
    }

    return count;
}

//TASK 2:
long long scalarProduct(int a[], int b[], size_t n) {
    int scalarSum = 0;
    for (int i = 0; i < n; i++) {
        int multiplication = a[i] * b[i];
        scalarSum += multiplication;
    }
    return scalarSum;
}

//TASK 3:
int GCD(int arr[], size_t size) {
    if (size <= 0) return 0;

    int currentElement;
    int smallestElement = arr[0];

    for (int i = 1; i < size; i++) {
        currentElement = arr[i];
        if (smallestElement > currentElement) {
            smallestElement = currentElement;
        }
    }

    int candidateForGCD = smallestElement;
    while (candidateForGCD > 0) {
        bool isDivisorOfAll = true;

        for (int i = 0; i < size; i++) {
            if (arr[i] % candidateForGCD != 0) {
                isDivisorOfAll = false;
                break;
            }
        }

        if (isDivisorOfAll) {
            return candidateForGCD;
        }
        candidateForGCD--;
    }

    return 1;
}

//TASK 4:
bool isZigZag(int arr[], size_t size) {
    if (size < 2) {
        return true;
    }

    for (size_t i = 1; i < size - 1; i++) {
        if (i % 2 == 0) {
            if (arr[i] >= arr[i + 1]) {
                return false;
            }
        }
        else {
            if (arr[i] <= arr[i + 1]) {
                return false;
            }
        }
    }
}

//TASK 5:
int inversionCount(int arr[], size_t size) {
    int count = 0;

    for (int i = 0; i < size; i++) {
        for (int j = i + 1; j < size; j++) {
            if (arr[i] > arr[j]) {
                count++;
            }
        }
    }

    return count;
}

//TASK 6:
double distanceBetweenCoordinates(int x1, int y1, int x2, int y2) {
    double distance = abs(x1 - x2) + abs(y1 - y2);
    return distance;
}

double manhattanDistanceMax(int arr1[], int arr2[], size_t size) {
    double currentDistance; 
    double maxDistance = 0;

    for (int i = 0; i < size; i++) {
        for (int j = i + 1; j < size; j++) {
            currentDistance = distanceBetweenCoordinates(arr1[i], arr2[i], arr1[j], arr2[j]);
            if (currentDistance > maxDistance) {
                maxDistance = currentDistance;
            }
        }
        
    }

    return maxDistance;
}

//TASK 7:
void multiplicationOfTwoPolynoms(int arrA[], int arrB[], int arrC[], size_t sizeA, size_t sizeB) {
    for (int i = 0; i < sizeA + sizeB - 1; i++) {
        arrC[i] = 0;
    }

    for (int i = 0; i < sizeA; i++) {
        for (int j = 0; j < sizeB; j++) {
            arrC[i + j] += arrA[i] * arrB[j];
        }
    }
}

//TASK 8:
int newStudentPlacementByHeight(int arr[], size_t size, int heightOfNewStudent) {
    int leftBound = 0;
    int rightBound = size;

    while (leftBound < rightBound) {
        int mid = leftBound + (rightBound - leftBound) / 2;

        if (arr[mid] < heightOfNewStudent) {
            leftBound = mid + 1;
        }
        else {
            rightBound = mid;
        }
    }

    return leftBound;
}

//TASK 9:
bool isPalyndrom(const int arr[], int size) {
    int start = 0;
    int end = size - 1;

    while (start < end) {
        if (arr[start] != arr[end]) {
            return false;
        }
        start++;
        end--;
    }

    return true;
}
bool isConcatenationOfTwoPalyndroms(const int arr[], int size) {
    for (int i = 0; i < size; i++) {
        if (isPalyndrom(arr, i) && isPalyndrom(arr + i, size - i)) {
            return true;
        }
    }

    return false;
}

