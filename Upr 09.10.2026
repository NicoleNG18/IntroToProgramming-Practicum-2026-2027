#include <iostream>

int main()
{
    int seconds;
    std::cin >> seconds;
    std::cout << seconds/(3600*24) << " days, "<<(seconds/3600)%24<<" hours, "<<(seconds/60)%60 <<" minutes, "<<seconds%60<<" seconds"<<std::endl;
