#include <iostream>

int main()
{
    int x1,x2,y1,y2;
    std::cin>>x1>>x2>>y1>>y2;
    std::cout<< std::boolalpha<<((x1 >= y1 && x1 <= y2) ||
         (x2 >= y1 && x2 <= y2) ||
         (y1 >= x1 && y1 <= x2) ||
         (y2 >= x1 && y2 <= x2))<<std::endl;
    
}


